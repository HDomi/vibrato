{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "rootDirs": [".", "platforms/mac"],
    "outDir": "dist",
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["electron/**/*.cts", "server/**/*.ts", "server/**/*.cts", "platforms/mac/electron/**/*.cts", "platforms/mac/server/**/*.ts"]
}
